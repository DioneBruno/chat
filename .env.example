# Opcional: copie para .env (não versionado). Sem ele valem os defaults do docker-compose.yml.

# Segredo do Typebot (>= 32 caracteres). Gerar: openssl rand -base64 24 | tr -d '\n'; echo
# Atenção: trocar depois de criar dados invalida o que foi criptografado.
# ENCRYPTION_SECRET=
# ADMIN_EMAIL=admin@poc.local

# Preencher após configurar o Typebot (builder em http://localhost:8082),
# depois `docker compose up -d api`.
TYPEBOT_ID=
TYPEBOT_API_TOKEN=

# POC #2
# BOT_INTERNAL_SECRET=
# OP_SIMULATED_MS=5000
# ASYNC_RESUME_MODE=continue
