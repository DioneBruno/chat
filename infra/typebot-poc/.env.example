# Copie para .env (não versionado) e ajuste se necessário.
# ENCRYPTION_SECRET: gerar com `openssl rand -base64 24 | tr -d '\n'; echo`
ENCRYPTION_SECRET=substitua-por-32-caracteres-aleatorios

DATABASE_URL=postgresql://postgres:typebot@typebot-db:5432/typebot

NODE_OPTIONS=--no-node-snapshot

NEXTAUTH_URL=http://localhost:8080
NEXT_PUBLIC_VIEWER_URL=http://localhost:8081

ADMIN_EMAIL=admin@poc.local

# Login por e-mail (magic link) via Mailpit (SMTP descartável local).
# E-mails enviados aparecem em http://localhost:8025 — não saem da máquina.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_AUTH_DISABLED=false
NEXT_PUBLIC_SMTP_FROM="Typebot POC <notifications@poc.local>"
